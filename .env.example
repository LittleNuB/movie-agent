# Documentation-only configuration example. No runtime loads this file yet.
# Model IDs reflect the 2026-09-06 source-workspace preflight, not new-repo validation.
# Keep real credentials outside Git. KEY_FILE fields are intentionally empty.
# Copying this example does not submit a model request or generate media.

FILM_LLM_PROVIDER=bigmodel
FILM_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FILM_LLM_MODEL=glm-5.3-flash
FILM_LLM_KEY_FILE=
FILM_LLM_THINKING=enabled
# The preflight succeeded with low; creative reasoning defaults remain unselected.
FILM_LLM_REASONING_EFFORT=low

FILM_VIDEO_PROVIDER=minimax
FILM_VIDEO_BASE_URL=https://api.minimax.cn/v2
FILM_VIDEO_MODEL=MiniMax-H3
FILM_VIDEO_KEY_FILE=

FILM_IMAGE_PROVIDER=volcengine_ark
FILM_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FILM_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
FILM_IMAGE_KEY_FILE=

FILM_VIDEO_FALLBACK_PROVIDER=volcengine_ark
FILM_VIDEO_FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FILM_VIDEO_FALLBACK_MODEL=doubao-seedance-2-0-260128
FILM_VIDEO_FALLBACK_KEY_FILE=

# Independent voice, music and SFX providers are not selected yet.
